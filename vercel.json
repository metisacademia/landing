{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "metisacademia.com.br" }],
      "destination": "https://www.metisacademia.com.br/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "metisacademia.com.br" }],
      "destination": "https://www.metisacademia.com.br/:path+",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/checkout", "destination": "/spa.html" },
    { "source": "/checkout/:path*", "destination": "/spa.html" },
    { "source": "/admin", "destination": "/spa.html" },
    { "source": "/admin/:path*", "destination": "/spa.html" }
  ]
}
